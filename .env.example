# demo: bundled synthetic data and explicitly labeled rule-based explanations.
# api: connect to Person 2's backend. There is NO silent fallback to demo.
VITE_DATA_MODE=demo

# Relative /api uses the Vite development proxy to localhost:8000.
# For a separately hosted backend, provide its full URL ending in /api.
VITE_API_BASE_URL=/api

# VITE_* values are PUBLIC. Never put an AI API key in this file.
