# Docker Compose reads this root .env. Local Python reads backend/.env instead.
AKIM_BIND_ADDRESS=127.0.0.1
AKIM_PORT=8080
# Explicit offline mode; change to app.services.team_advisor:TeamAdvisor for AI.
AKIM_ADVISOR_FACTORY=app.services.ai_advisor:RuleBasedAdvisor
AKIM_ANALYSIS_VERSION=person4-v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
