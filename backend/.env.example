# Relative paths are resolved from this backend directory, not your shell's cwd.
AKIM_DATA_DIR=../data/v1
AKIM_DATABASE_PATH=var/akim.sqlite3
AKIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default: honest rule-based assessment; no model or API key required.
# Person 3 can replace this with their own async Advisor factory.
AKIM_ADVISOR_FACTORY=app.services.ai_advisor:RuleBasedAdvisor
AKIM_ANALYSIS_VERSION=1
AKIM_ANALYSIS_TIMEOUT_SECONDS=45

# Model credentials belong only in the backend environment. Never use VITE_*.
