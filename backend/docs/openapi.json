{
  "openapi": "3.1.0",
  "info": {
    "title": "Akim for 5 Hours API",
    "description": "Synthetic city simulation. Budget and scores are server-calculated. Default analysis is rule-based.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/config": {
      "get": {
        "tags": [
          "Configuration"
        ],
        "summary": "Configuration",
        "description": "Identical starting budget, model, districts and initiatives for every user.",
        "operationId": "configuration_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Configuration"
                }
              }
            }
          }
        }
      }
    },
    "/api/preview": {
      "post": {
        "tags": [
          "Scenarios"
        ],
        "summary": "Preview",
        "description": "Calculate a partial or complete plan without writing it to the database.",
        "operationId": "preview_api_preview_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScenarioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scenarios": {
      "post": {
        "tags": [
          "Scenarios"
        ],
        "summary": "Create",
        "description": "Validate and atomically persist exactly five decisions plus their result snapshot.",
        "operationId": "create_api_scenarios_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScenarioRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scenario"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scenarios/{scenario_id}": {
      "get": {
        "tags": [
          "Scenarios"
        ],
        "summary": "Retrieve",
        "operationId": "retrieve_api_scenarios__scenario_id__get",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scenario"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scenarios/{scenario_id}/analysis": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "summary": "Analyze",
        "description": "Return a cached or newly generated, explicitly labeled assessment.",
        "operationId": "analyze_api_scenarios__scenario_id__analysis_post",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Analysis"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "title": "Status",
            "default": "completed"
          },
          "source": {
            "type": "string",
            "enum": [
              "ai",
              "rules"
            ],
            "title": "Source"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "strengths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strengths"
          },
          "risks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Risks"
          },
          "tradeoffs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tradeoffs"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Recommendations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "summary",
          "strengths",
          "risks",
          "tradeoffs",
          "recommendations"
        ],
        "title": "Analysis"
      },
      "Candidate": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/Decision"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 5,
            "title": "Decisions"
          },
          "total_cost": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Cost"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidate_id",
          "title",
          "explanation",
          "decisions",
          "total_cost",
          "score"
        ],
        "title": "Candidate"
      },
      "Category": {
        "type": "string",
        "enum": [
          "transport",
          "greening",
          "social",
          "safety",
          "services"
        ],
        "title": "Category"
      },
      "Configuration": {
        "properties": {
          "dataset_version": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Dataset Version"
          },
          "engine_version": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Engine Version"
          },
          "initial_budget": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Initial Budget"
          },
          "required_decisions": {
            "type": "integer",
            "const": 5,
            "title": "Required Decisions"
          },
          "indicator_weights": {
            "$ref": "#/components/schemas/Effects"
          },
          "city_average_weight": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "City Average Weight"
          },
          "lowest_district_weight": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Lowest District Weight"
          },
          "districts": {
            "items": {
              "$ref": "#/components/schemas/District"
            },
            "type": "array",
            "minItems": 1,
            "title": "Districts"
          },
          "initiatives": {
            "items": {
              "$ref": "#/components/schemas/Initiative"
            },
            "type": "array",
            "minItems": 5,
            "title": "Initiatives"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_version",
          "engine_version",
          "initial_budget",
          "required_decisions",
          "indicator_weights",
          "city_average_weight",
          "lowest_district_weight",
          "districts",
          "initiatives"
        ],
        "title": "Configuration"
      },
      "Decision": {
        "properties": {
          "initiative_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Initiative Id"
          },
          "district_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "District Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "initiative_id",
          "district_id"
        ],
        "title": "Decision"
      },
      "District": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "population": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Population"
          },
          "indicators": {
            "$ref": "#/components/schemas/Indicators"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "population",
          "indicators"
        ],
        "title": "District"
      },
      "Effects": {
        "properties": {
          "transport": {
            "type": "number",
            "title": "Transport"
          },
          "greening": {
            "type": "number",
            "title": "Greening"
          },
          "social": {
            "type": "number",
            "title": "Social"
          },
          "safety": {
            "type": "number",
            "title": "Safety"
          },
          "services": {
            "type": "number",
            "title": "Services"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transport",
          "greening",
          "social",
          "safety",
          "services"
        ],
        "title": "Effects"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Indicators": {
        "properties": {
          "transport": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Transport"
          },
          "greening": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Greening"
          },
          "social": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Social"
          },
          "safety": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Safety"
          },
          "services": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Services"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transport",
          "greening",
          "social",
          "safety",
          "services"
        ],
        "title": "Indicators"
      },
      "Initiative": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "cost": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cost"
          },
          "eligible_district_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Eligible District Ids"
          },
          "effects": {
            "$ref": "#/components/schemas/Effects"
          },
          "tradeoffs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tradeoffs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "category",
          "name",
          "description",
          "cost",
          "eligible_district_ids",
          "effects",
          "tradeoffs"
        ],
        "title": "Initiative"
      },
      "Preview": {
        "properties": {
          "dataset_version": {
            "type": "string",
            "title": "Dataset Version"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "decision_count": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Decision Count"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete"
          },
          "initial_budget": {
            "type": "integer",
            "title": "Initial Budget"
          },
          "total_cost": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Cost"
          },
          "remaining_budget": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Remaining Budget"
          },
          "baseline": {
            "$ref": "#/components/schemas/ScoreSnapshot"
          },
          "final": {
            "$ref": "#/components/schemas/ScoreSnapshot"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_version",
          "engine_version",
          "decision_count",
          "complete",
          "initial_budget",
          "total_cost",
          "remaining_budget",
          "baseline",
          "final"
        ],
        "title": "Preview"
      },
      "Scenario": {
        "properties": {
          "dataset_version": {
            "type": "string",
            "title": "Dataset Version"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "decision_count": {
            "type": "integer",
            "const": 5,
            "title": "Decision Count"
          },
          "complete": {
            "type": "boolean",
            "const": true,
            "title": "Complete"
          },
          "initial_budget": {
            "type": "integer",
            "title": "Initial Budget"
          },
          "total_cost": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Cost"
          },
          "remaining_budget": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Remaining Budget"
          },
          "baseline": {
            "$ref": "#/components/schemas/ScoreSnapshot"
          },
          "final": {
            "$ref": "#/components/schemas/ScoreSnapshot"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/Decision"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 5,
            "title": "Decisions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_version",
          "engine_version",
          "decision_count",
          "complete",
          "initial_budget",
          "total_cost",
          "remaining_budget",
          "baseline",
          "final",
          "id",
          "created_at",
          "decisions"
        ],
        "title": "Scenario"
      },
      "ScenarioRequest": {
        "properties": {
          "dataset_version": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Dataset Version"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/Decision"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Decisions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_version",
          "decisions"
        ],
        "title": "ScenarioRequest"
      },
      "ScoreSnapshot": {
        "properties": {
          "districts": {
            "items": {
              "$ref": "#/components/schemas/ScoredDistrict"
            },
            "type": "array",
            "title": "Districts"
          },
          "city_average": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "City Average"
          },
          "lowest_district": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Lowest District"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "districts",
          "city_average",
          "lowest_district",
          "score"
        ],
        "title": "ScoreSnapshot"
      },
      "ScoredDistrict": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "population": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Population"
          },
          "indicators": {
            "$ref": "#/components/schemas/Indicators"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "population",
          "indicators",
          "score"
        ],
        "title": "ScoredDistrict"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
